---
import Base from '../layouts/Base.astro';
import { recetas, formatTiempo } from '../lib/recetas.js';

const filtros = [
  { label: 'Dulce', key: 'tipo', val: 'dulce' },
  { label: 'Salado', key: 'tipo', val: 'salado' },
  { label: 'Veggie', key: 'veggie', val: 'si' },
  { label: 'Fácil', key: 'dif', val: 'Fácil' },
  { label: 'Media', key: 'dif', val: 'Media' },
  { label: 'Difícil', key: 'dif', val: 'Difícil' },
  { label: '< 30 min', key: 'tiempo', val: 'a' },
  { label: '30–60 min', key: 'tiempo', val: 'b' },
  { label: '+ 1 hora', key: 'tiempo', val: 'c' },
  { label: '1–2 porc.', key: 'porc', val: 'a' },
  { label: '3–4 porc.', key: 'porc', val: 'b' },
  { label: '5+ porc.', key: 'porc', val: 'c' },
];
const tb = (m) => (m < 30 ? 'a' : m <= 60 ? 'b' : 'c');
const pb = (p) => (p <= 2 ? 'a' : p <= 4 ? 'b' : 'c');
const norm = (t) => String(t).normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
const buscable = (r) =>
  norm([r.titulo, r.subtitulo, r.autora, ...r.versiones.flatMap((v) => v.ingredientes.flatMap((g) => g.items.map((i) => i.text)))].join(' '));
const porcLabel = (r) => (r.unidad === 'porciones' ? `${r.porciones} porc.` : `${r.porciones} ${r.unidad}`);
---
<Base title="Recetario">
  <header class="wrap head">
    <div class="top">
      <span class="mono small muted">Recetas de la casa<br />Nº {recetas.length} · Milano</span>
      <svg aria-hidden="true" width="70" height="56" viewBox="0 0 70 56" fill="none" stroke="#141414" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 22c1-9 9-15 18-14 9 2 14 9 12 17-2 7-10 11-18 9-8-1-13-6-12-12z"></path><path d="M36 30c8 6 17 13 26 22"></path><path d="M16 18c3-3 7-4 11-3"></path></svg>
    </div>
    <div class="title-wrap">
      <h1 class="display title">Recetario</h1>
      <svg aria-hidden="true" class="underline" viewBox="0 0 190 16" preserveAspectRatio="none" fill="none" stroke="#B3282D" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke"><path d="M3 10c18-7 30 5 48-1s30-6 46 0 34 4 50-3 26-2 40 2" vector-effect="non-scaling-stroke"></path></svg>
    </div>
    <label class="search">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#141414" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
      <span class="sr-only">Buscar receta o ingrediente</span>
      <input id="q" type="search" placeholder="Buscar receta o ingrediente" autocomplete="off" />
    </label>
  </header>

  <div class="band">
    <div class="wrap">
      <span class="mono small strong">Filtrar</span>
      <div class="chips" role="group" aria-label="Filtros">
        {filtros.map((f) => (
          <button type="button" class="chip" data-key={f.key} data-val={f.val} aria-pressed="false">{f.label}</button>
        ))}
      </div>
    </div>
  </div>

  <main class="wrap">
    <div class="count">
      <span id="count" class="mono small muted" aria-live="polite">Todas las recetas</span>
      <button id="clear" type="button" class="mono small link" hidden>Limpiar</button>
    </div>
    <p id="empty" class="empty" hidden>Ninguna receta coincide con estos filtros.</p>
    <ul class="grid">
      {recetas.map((r) => (
        <li
          class="card"
          data-tipo={r.tipo}
          data-veggie={r.veggie ? 'si' : 'no'}
          data-dif={r.dificultad}
          data-tiempo={tb(r.tiempo_min)}
          data-porc={pb(r.porciones)}
          data-text={buscable(r)}
        >
          <a href={`/recetas/${r.slug}/`}>
            <div class="ph">
              <img src={r.imagen} alt="" loading="lazy" width="600" height="480" />
              {r.veggie && <span class="mono veg">Veggie</span>}
            </div>
            <span class="display card-title">{r.titulo}</span>
            <span class="mono meta">{formatTiempo(r.tiempo_min)} · {r.dificultad} · {porcLabel(r)}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .head { padding-top: 28px; padding-bottom: 18px; display: flex; flex-direction: column; gap: 6px; }
  .top { display: flex; justify-content: space-between; align-items: flex-start; }
  .small { font-size: 11px; }
  .muted { color: var(--muted); }
  .strong { font-weight: 500; }
  .title { margin: 4px 0 0; font-size: 1em; color: var(--red); }
  .title-wrap { align-self: flex-start; display: flex; flex-direction: column; font-size: clamp(64px, 14vw, 140px); }
  .underline { width: 62%; height: 0.13em; margin-top: 0.08em; stroke-width: clamp(3px, 0.035em, 6px); }
  .search { margin-top: 14px; display: flex; align-items: center; gap: 10px; height: 48px; padding: 0 16px; border: 1.5px solid var(--ink); border-radius: 999px; max-width: 520px; }
  .search input { flex: 1; min-width: 0; border: 0; background: transparent; font: inherit; font-size: 16px; color: var(--ink); outline: none; }
  .search input::placeholder { color: var(--muted); }
  .band { background: var(--blue); padding: 14px 0 12px; }
  .band .wrap { display: flex; flex-direction: column; gap: 8px; }
  .chips { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; scrollbar-width: none; flex-wrap: nowrap; }
  .chips::-webkit-scrollbar { display: none; }
  @media (min-width: 900px) { .chips { flex-wrap: wrap; } }
  .count { display: flex; justify-content: space-between; align-items: center; min-height: 44px; padding: 10px 0 8px; }
  .link { height: 44px; border: 0; background: transparent; color: var(--red); font-weight: 500; text-decoration: underline; cursor: pointer; padding: 0 4px; }
  .empty { padding: 40px 0; text-align: center; color: var(--muted); }
  .grid { list-style: none; margin: 0; padding: 4px 0 48px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 14px; }
  @media (min-width: 700px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px 24px; } }
  @media (min-width: 1000px) { .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .card a { display: flex; flex-direction: column; gap: 4px; text-decoration: none; }
  .card[hidden] { display: none; }
  .ph { position: relative; border-bottom: 1.5px solid var(--ink); aspect-ratio: 5 / 4; display: flex; align-items: center; justify-content: center; }
  .ph img { width: 100%; height: 100%; object-fit: contain; transition: transform 0.25s ease; }
  .card a:hover .ph img { transform: scale(1.04) rotate(-1deg); }
  .veg { position: absolute; top: 6px; left: 0; font-size: 10px; font-weight: 500; background: var(--bg); border: 1px solid var(--ink); border-radius: 999px; padding: 2px 8px; }
  .card-title { margin-top: 10px; font-size: 22px; font-weight: 700; line-height: 1; letter-spacing: -0.01em; }
  .meta { font-size: 10.5px; color: var(--muted); line-height: 1.5; }
</style>

<script>
  const state = { tipo: null, veggie: null, dif: null, tiempo: null, porc: null };
  const q = document.getElementById('q');
  const chips = [...document.querySelectorAll('.chip')];
  const cards = [...document.querySelectorAll('.card')];
  const count = document.getElementById('count');
  const clear = document.getElementById('clear');
  const empty = document.getElementById('empty');
  const norm = (t) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();

  function apply() {
    const term = norm(q.value);
    let n = 0;
    for (const c of cards) {
      const d = c.dataset;
      const ok = (!term || d.text.includes(term)) &&
        Object.entries(state).every(([k, v]) => !v || d[k] === v);
      c.hidden = !ok;
      if (ok) n++;
    }
    const active = term || Object.values(state).some(Boolean);
    count.textContent = active ? (n === 1 ? '1 resultado' : `${n} resultados`) : 'Todas las recetas';
    clear.hidden = !active;
    empty.hidden = n > 0;
    chips.forEach((ch) => ch.setAttribute('aria-pressed', String(state[ch.dataset.key] === ch.dataset.val)));
  }

  chips.forEach((ch) => ch.addEventListener('click', () => {
    const { key, val } = ch.dataset;
    state[key] = state[key] === val ? null : val;
    apply();
  }));
  q.addEventListener('input', apply);
  clear.addEventListener('click', () => { Object.keys(state).forEach((k) => (state[k] = null)); q.value = ''; apply(); });
</script>
